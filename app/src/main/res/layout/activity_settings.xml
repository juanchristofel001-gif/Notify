<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buka izin akses notifikasi" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Gemini API key (buat di Google AI Studio)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AIza..."
            android:inputType="textPassword"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Model"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tentang aku (apa yang penting buatku)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Contoh: lagi magang di OJK, cari kerja mulai Oktober, email rekrutmen &amp; dosen penting, grup angkatan tidak penting"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kontak / pengirim VIP (pisahkan dengan koma)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/vip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mama, Papa, Bu Eneng, HRD"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:importantForAutofill="no" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tangkap notifikasi dari semua aplikasi (matikan untuk hanya WA, Facebook, Messenger, dan email)" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Beri peringatan khusus untuk notifikasi URGENT" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Simpan" />

        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tes koneksi Gemini" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Catatan privasi: isi notifikasi (termasuk kode OTP) dikirim ke Google Gemini untuk dipilah. Tanpa API key, aplikasi memakai aturan kata kunci sederhana dan tidak mengirim apa pun."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
